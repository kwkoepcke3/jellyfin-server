[Unit]
Description=Bazarr
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=bazarr
Image=lscr.io/linuxserver/bazarr:1.6.2

Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=America/New_York

Volume=/home/user/mayo-server/subserv/jellyfin/runtime/radarr/config:/config:z
Volume=/var/mnt/jellyfin:/data/media/disks:Z

PublishPort=10003:6767

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
