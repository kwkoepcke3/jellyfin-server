[Unit]
Description=Radarr
After=tailscale.service
BindsTo=tailscale.service

[Container]
ContainerName=radarr
Image=lscr.io/linuxserver/radarr:7.0.3

Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=America/New_York

Volume=/home/user/mayo-server/subserv/jellyfin/runtime/radarr/config:/config:z
Volume=/var/mnt/jellyfin:/data:z

Network=container:tailscale

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
