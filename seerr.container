[Unit]
Description=Seerr
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=seerr
Image=docker.io/seerr/seerr:v3.5.2
Network=traefik.network

Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=America/New_York
Environment=PORT=5055

Volume=/home/user/mayo-server/subserv/jellyfin/runtime/seerr/config:/config:z

PublishPort=5055:5055

Label=traefik.enable=true
Label=traefik.http.routers.seerr.rule=Host(`request.meiyou.io`)
Label=traefik.http.routers.seerr.entrypoints=websecure
Label=traefik.http.routers.seerr.tls.certresolver=websecure
Label=traefik.http.services.seerr.loadbalancer.server.port=5055

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
