[Unit]
Description=Sonarr
After=tailscale.service
BindsTo=tailscale.service

[Container]
ContainerName=sonarr
Image=lscr.io/linuxserver/sonarr:4.0.20

Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=America/New_York

Volume=/home/user/mayo-server/subserv/jellyfin/runtime/sonarr/config:/config:z
Volume=/var/mnt/jellyfin:/data:z

Network=container:tailscale

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
