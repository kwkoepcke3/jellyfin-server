[Unit]
Description=Traefik Reverse Proxy
After=network-online.target podman.socket
Wants=network-online.target
Requires=podman.socket

[Container]
ContainerName=traefik
Image=docker.io/library/traefik:v3.4
NoNewPrivileges=true
SecurityLabelDisable=true

# Load EMAIL and CF_API_TOKEN for both container env and Exec= expansion
EnvironmentFile=%h/.config/containers/systemd/traefik.env

Environment=CF_API_EMAIL=${EMAIL} \
            CF_DNS_API_TOKEN=${CF_API_TOKEN}

PublishPort=80:80
PublishPort=443:443

# Drop in replacement for docker engine
Volume=%t/podman/podman.sock:/var/run/docker.sock:ro
Volume=%h/jellyfin/runtime/traefik/letsencrypt:/letsencrypt:Z

Exec=--providers.docker=true \
     --providers.docker.exposedbydefault=false \
     --entryPoints.websecure.address=:443 \
     --entryPoints.websecure.http.tls=true \
     --entryPoints.web.address=:80 \
     --entryPoints.web.http.redirections.entrypoint.to=websecure \
     --entryPoints.web.http.redirections.entrypoint.scheme=https \
     --certificatesResolvers.websecure.acme.dnsChallenge.provider=cloudflare \
     --certificatesResolvers.websecure.acme.email=${EMAIL} \
     --certificatesResolvers.websecure.acme.storage=/letsencrypt/acme.json \
     --api=true \
     --api.dashboard=true \
     --certificatesResolvers.websecure.acme.caServer=https://acme-staging-v02.api.letsencrypt.org/directory

Label=traefik.enable=true \
      traefik.http.routers.dashboard.rule=Host(`traefik.meiyou.io`) \
      traefik.http.routers.dashboard.entrypoints=websecure \
      traefik.http.routers.dashboard.service=api@internal \
      traefik.http.routers.dashboard.tls.certresolver=websecure \
      traefik.http.routers.dashboard.middlewares=auth

[Service]
Restart=always
EnvironmentFile=%h/.config/containers/systemd/traefik.env

[Install]
WantedBy=default.target
